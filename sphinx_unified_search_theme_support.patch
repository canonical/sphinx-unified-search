+++ b/src/sphinx_unified_search/static/unified-search-filter-ulwazi.css
@@ -0,0 +1,65 @@
+/*
+ * sphinx-unified-search: project filter chips for Ulwazi theme.
+ * Uses Canonical Vanilla Framework design tokens and Ulwazi color scheme.
+ */
+.unified-search-filter {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem;
+  margin: 1.25rem 0;
+}
+
+.unified-search-filter__label {
+  font-size: 0.875rem;
+  font-weight: 500;
+  color: var(--vf-color-text-default, inherit);
+}
+
+.unified-search-chip {
+  font: inherit;
+  font-size: 0.875rem;
+  line-height: 1.25rem;
+  padding: 0.25rem 0.75rem;
+  border: 1px solid var(--vf-color-border-default, #d9d9d9);
+  border-radius: 999px;
+  background: var(--vf-color-background-default, #fff);
+  color: var(--vf-color-text-default, inherit);
+  cursor: pointer;
+  transition: background-color 0.15s ease, border-color 0.15s ease;
+}
+
+.unified-search-chip:hover {
+  border-color: var(--ulwazi-color-brand, #e95420);
+}
+
+.unified-search-chip:focus-visible {
+  outline: 2px solid var(--ulwazi-color-brand, #e95420);
+  outline-offset: 2px;
+}
+
+.unified-search-chip[aria-pressed="true"] {
+  background: var(--ulwazi-color-brand, #e95420);
+  border-color: var(--ulwazi-color-brand, #e95420);
+  color: #fff;
+}
+
+.unified-search-chip__count {
+  margin-left: 0.25rem;
+  font-size: 0.8125rem;
+  opacity: 0.85;
+}
+
+body.is-dark .unified-search-chip,
+[data-theme="dark"] .unified-search-chip {
+  background: var(--vf-color-background-default, #262626);
+  border-color: var(--vf-color-border-default, rgba(255, 255, 255, 0.2));
+  color: var(--vf-color-text-default, #fff);
+}
+
+body.is-dark .unified-search-chip[aria-pressed="true"],
+[data-theme="dark"] .unified-search-chip[aria-pressed="true"] {
+  background: var(--ulwazi-color-brand, #e95420);
+  border-color: var(--ulwazi-color-brand, #e95420);
+  color: #fff;
+}
